#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

config EXAMPLES_BEV_CLUSTER
	tristate "BEV Truck Digital Cluster"
	default n
	depends on GRAPHICS_LVGL
	---help---
		Enable BEV truck digital cluster with speedometer and battery display

if EXAMPLES_BEV_CLUSTER

config EXAMPLES_BEV_CLUSTER_PROGNAME
	string "Program name"
	default "cluster"
	---help---
		This is the name of the program that will be used when the NSH ELF
		program is installed.

config EXAMPLES_BEV_CLUSTER_PRIORITY
	int "BEV Cluster task priority"
	default 100

config EXAMPLES_BEV_CLUSTER_STACKSIZE
	int "BEV Cluster stack size"
	default 16384

endif
